* {
  box-sizing: border-box;
}

:root {
  --navy-900: #071f41;
  --navy-800: #0c2b52;
  --navy-700: #11335d;
  --white: #ffffff;
  --shell: #f3f3f3;
  --card: #f5f5f5;
  --muted: #5d6471;
  --line: #dfe3e6;
  --shadow: rgba(15, 20, 30, 0.08);
  --pending-bg: #f6dfe0;
  --pending-text: #8a3b3d;
  --success: #1c9a61;
  --danger: #cc3f3f;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  font-family: 'Inter', sans-serif;
  background: #111827;
}

body {
  min-height: 100vh;
}

button, input, textarea {
  font-family: inherit;
}

.app-shell {
  min-height: 100vh;
  background: var(--shell);
  color: var(--navy-900);
}

.theme-dark {
  --shell: #101820;
  --card: #1b2638;
  --white: #dfe8f7;
  --navy-900: #edf3ff;
  --muted: #b6c0d1;
  --line: rgba(255,255,255,0.08);
  --shadow: rgba(0, 0, 0, 0.25);
}

.auth-screen {
  min-height: 100vh;
  background: linear-gradient(180deg, #071d3d 0%, #081c3c 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 48px 20px;
}

.hero-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 34px;
}

.brand-mark {
  width: 280px;
  height: 140px;
  display: grid;
  place-items: center;
  margin-bottom: 18px;
  position: relative;
}

.brand-mark-inner {
  width: 180px;
  height: 112px;
  display: grid;
  place-items: center;
  border-radius: 24px;
  background: linear-gradient(135deg, #f2f5fb, #edf2fa);
  color: #081d3f;
  font-size: 90px;
  font-weight: 900;
  transform: skew(-18deg);
  box-shadow: inset 0 0 0 2px rgba(255,255,255,0.1);
}

.brand-copy {
  text-align: center;
  color: white;
}

.brand-copy h1 {
  font-size: clamp(4rem, 8vw, 8rem);
  letter-spacing: -0.08em;
  margin: 0;
  line-height: 0.9;
}

.brand-copy p {
  margin-top: 14px;
  font-size: clamp(1rem, 2vw, 1.8rem);
  font-weight: 500;
  color: rgba(255,255,255,0.8);
  letter-spacing: 0.12em;
  text-transform: none;
}

.auth-card {
  width: min(100%, 520px);
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.09);
  border-radius: 32px;
  padding: 22px;
  backdrop-filter: blur(8px);
}

.auth-toggle {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  background: rgba(255,255,255,0.08);
  border-radius: 16px;
  padding: 8px;
  margin-bottom: 20px;
}

.auth-toggle button {
  border: none;
  background: transparent;
  color: rgba(255,255,255,0.8);
  padding: 12px 16px;
  border-radius: 12px;
  font-weight: 600;
  cursor: pointer;
}

.auth-toggle button.active {
  background: rgba(255,255,255,0.14);
  color: white;
}

.auth-form {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.auth-form label, .withdraw-form label, .inline-form label {
  display: flex;
  flex-direction: column;
  gap: 10px;
  color: rgba(255,255,255,0.92);
  font-weight: 600;
}

.auth-form input,
.withdraw-form input,
.inline-form input,
.support-form textarea,
.transfer-search-box input {
  border: 1px solid rgba(15, 27, 44, 0.16);
  border-radius: 14px;
  background: rgba(255,255,255,0.94);
  height: 56px;
  padding: 0 18px;
  font-size: 1.05rem;
  color: var(--navy-900);
  outline: none;
}

.support-form textarea {
  min-height: 120px;
  padding: 18px;
  resize: vertical;
}

.primary-button {
  border: none;
  border-radius: 14px;
  background: linear-gradient(180deg, #0d244f 0%, #071e42 100%);
  color: white;
  min-height: 54px;
  font-size: 1.1rem;
  font-weight: 700;
  cursor: pointer;
  transition: transform 0.18s ease;
}

.primary-button:hover {
  transform: translateY(-1px);
}

.quick-credentials {
  margin-top: 6px;
  color: rgba(255,255,255,0.85);
  line-height: 1.6;
  text-align: center;
}

.main-layout {
  min-height: 100vh;
  background: var(--shell);
}

.topbar {
  height: 82px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20px 0 18px;
  border-bottom: 1px solid rgba(14, 23, 39, 0.12);
  background: rgba(255,255,255,0.7);
}

.menu-button {
  width: 32px;
  height: 28px;
  background: transparent;
  border: none;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  cursor: pointer;
}

.menu-button span {
  display: block;
  width: 100%;
  height: 3px;
  background: #2d384c;
  border-radius: 2px;
}

.topbar-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  background: linear-gradient(135deg, #0d2346, #081b39);
  border-radius: 12px;
  padding: 8px 14px;
  color: white;
  font-weight: 800;
  font-size: 0.92rem;
}

.brand-mini {
  width: 30px;
  height: 30px;
  border-radius: 9px;
  background: rgba(255,255,255,0.1);
  display: grid;
  place-items: center;
}

.main-content {
  padding: 28px 18px 18px;
  max-width: 1100px;
  margin: 0 auto;
}

.page-shell {
  background: transparent;
  width: min(100%, 980px);
  margin: 0 auto;
}

.dashboard-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 18px;
}

.eyebrow {
  margin: 0 0 6px;
  font-size: 0.9rem;
  color: var(--muted);
  font-weight: 600;
}

.dashboard-header h2,
.page-shell h2 {
  margin: 0;
  font-size: clamp(2.2rem, 5vw, 4rem);
  letter-spacing: -0.07em;
  line-height: 1;
  color: var(--navy-900);
}

.desktop-button {
  border: none;
  border-radius: 10px;
  background: var(--navy-900);
  color: white;
  font-weight: 700;
  padding: 12px 16px;
  cursor: pointer;
}

.account-card {
  background: linear-gradient(140deg, #0f294f 0%, #071a30 100%);
  color: white;
  border-radius: 22px;
  padding: 26px 24px;
  box-shadow: 0 18px 30px var(--shadow);
  margin-bottom: 22px;
}

.account-meta-row {
  display: flex;
  justify-content: space-between;
  font-size: 0.9rem;
  opacity: 0.8;
  margin-bottom: 16px;
}

.account-balance {
  font-size: clamp(2.3rem, 5vw, 4rem);
  line-height: 1;
  font-weight: 800;
  letter-spacing: -0.06em;
}

.account-number {
  margin-top: 14px;
  letter-spacing: 0.14em;
  opacity: 0.8;
  font-size: 0.84rem;
}

.quick-actions {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 26px;
}

.action-card {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  min-height: 90px;
  background: rgba(255,255,255,0.8);
  border: 1px solid var(--line);
  border-radius: 20px;
  font-size: 1.08rem;
  font-weight: 700;
  color: var(--navy-900);
  cursor: pointer;
}

.section-panel {
  background: rgba(255,255,255,0.75);
  border: 1px solid var(--line);
  border-radius: 22px;
  padding: 20px;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 18px;
}

.section-head h3 {
  margin: 0;
  font-size: 1.5rem;
  color: var(--navy-900);
}

.text-button {
  border: none;
  background: transparent;
  color: var(--navy-700);
  font-weight: 700;
  cursor: pointer;
}

.list-stack {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.activity-item {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  align-items: center;
  padding: 14px 0;
  border-top: 1px solid var(--line);
}

.activity-item:first-child {
  border-top: none;
}

.activity-item strong,
.activity-item b {
  display: block;
}

.activity-item span {
  display: block;
  margin-top: 5px;
  color: var(--muted);
  font-size: 0.82rem;
}

.transfer-search-box {
  margin: 18px 0 20px;
}

.transfer-search-box input {
  width: 100%;
}

.banks-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
  margin-bottom: 24px;
}

.bank-card {
  display: flex;
  align-items: center;
  gap: 16px;
  min-height: 90px;
  background: rgba(255,255,255,0.7);
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 18px 20px;
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--navy-900);
  cursor: pointer;
}

.bank-card.selected,
.segmented-toggle button.selected,
.segmented-mini button.selected {
  background: rgba(12, 34, 63, 0.07);
  border-color: rgba(12, 34, 63, 0.2);
  box-shadow: inset 0 0 0 1px rgba(12, 34, 63, 0.08);
}

.bank-logo {
  width: 46px;
  height: 46px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: rgba(12, 34, 63, 0.08);
}

.inline-form,
.withdraw-form {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.inline-form .primary-button,
.withdraw-form .primary-button {
  margin-top: 4px;
}

.two-col {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}

.subtitle {
  margin: 10px 0 20px;
  font-size: 1.12rem;
  color: var(--muted);
}

.segmented-toggle {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 26px;
}

.segmented-toggle button,
.segmented-mini button {
  border: 1px solid var(--line);
  background: rgba(255,255,255,0.7);
  color: var(--navy-900);
  border-radius: 18px;
  min-height: 82px;
  font-size: 1.05rem;
  font-weight: 700;
  cursor: pointer;
}

.section-head h3,
.token-page h2,
.settings-page h2,
.transfer-page h2,
.withdraw-page h2,
.support-page h2,
.admin-page h2 {
  margin: 0 0 20px;
  font-size: clamp(2.3rem, 4vw, 4rem);
  letter-spacing: -0.07em;
}

.continue-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  font-size: 1.5rem;
}

.token-page {
  padding-top: 8px;
}

.token-banner {
  display: flex;
  align-items: center;
  gap: 18px;
  background: var(--pending-bg);
  border: 1px solid rgba(160, 69, 69, 0.1);
  color: var(--pending-text);
  border-radius: 22px;
  padding: 20px 22px;
  margin: 18px 0 18px;
}

.token-icon {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  border: 2px solid var(--pending-text);
  display: grid;
  place-items: center;
  font-weight: 800;
  flex-shrink: 0;
}

.token-banner h3 {
  margin: 0 0 8px;
  font-size: 1.2rem;
  letter-spacing: 0.02em;
}

.token-banner p {
  margin: 0;
  font-size: 1.1rem;
  line-height: 1.4;
}

.asset-box {
  margin: 18px 0 16px;
}

.asset-box h3 {
  font-size: clamp(1.8rem, 3vw, 2.6rem);
  margin: 0 0 16px;
  letter-spacing: -0.05em;
}

.asset-box ul {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
  font-size: 1.2rem;
}

.support-message {
  margin: 26px 0 18px;
  color: var(--navy-900);
  font-size: clamp(1.2rem, 2.2vw, 1.7rem);
  line-height: 1.45;
}

.support-action {
  width: 100%;
  min-height: 62px;
  border: none;
  border-radius: 14px;
  background: linear-gradient(180deg, #0d244f 0%, #071e42 100%);
  color: white;
  font-size: 1.3rem;
  font-weight: 800;
  cursor: pointer;
}

.details-grid {
  margin-top: 28px;
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 18px 12px;
  align-items: center;
  padding-top: 16px;
  border-top: 1px solid var(--line);
  font-size: 1.2rem;
}

.details-grid span {
  color: var(--muted);
}

.details-grid strong {
  text-align: right;
}

.support-thread {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 18px;
}

.bubble {
  max-width: 75%;
  padding: 14px 16px;
  border-radius: 18px;
  font-size: 1rem;
  line-height: 1.5;
}

.bubble.user {
  align-self: flex-end;
  background: var(--navy-900);
  color: white;
}

.bubble.admin {
  align-self: flex-start;
  background: rgba(255,255,255,0.8);
  border: 1px solid var(--line);
}

.bubble p {
  margin: 0;
}

.settings-card,
.info-card {
  background: rgba(255,255,255,0.7);
  border: 1px solid var(--line);
  border-radius: 20px;
  padding: 18px;
}

.settings-card {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.settings-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  min-height: 52px;
  padding: 8px 0;
  border-bottom: 1px solid var(--line);
}

.settings-row:last-child {
  border-bottom: none;
}

.settings-row span {
  font-size: 1.1rem;
  font-weight: 600;
}

.settings-row button {
  border: none;
  background: transparent;
  color: var(--navy-900);
  font-weight: 700;
  cursor: pointer;
}

.danger-button {
  color: var(--danger) !important;
}

.segmented-mini {
  display: inline-flex;
  gap: 8px;
}

.segmented-mini button {
  min-height: 38px;
  border-radius: 10px;
  padding: 0 14px;
}

.info-card {
  margin-top: 18px;
}

.info-card p {
  margin: 0 0 8px;
  color: var(--muted);
}

.info-card strong {
  font-size: 1.2rem;
}

.admin-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.admin-request {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  background: rgba(255,255,255,0.7);
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 18px;
}

.admin-request strong,
.admin-request b {
  display: block;
}

.admin-request span {
  display: block;
  margin-top: 6px;
  color: var(--muted);
}

.right-side {
  display: flex;
  align-items: center;
  gap: 16px;
}

.right-side button {
  border: none;
  background: var(--navy-900);
  color: white;
  border-radius: 10px;
  padding: 10px 16px;
  font-weight: 700;
  cursor: pointer;
}

.bottom-nav {
  position: sticky;
  bottom: 0;
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 12px;
  padding: 12px 18px 18px;
  background: rgba(255,255,255,0.86);
  border-top: 1px solid rgba(14, 23, 39, 0.12);
  backdrop-filter: blur(8px);
}

.bottom-nav button {
  border: none;
  background: transparent;
  color: var(--muted);
  font-weight: 700;
  min-height: 48px;
  border-radius: 12px;
  cursor: pointer;
}

.bottom-nav button.active {
  background: rgba(12, 34, 63, 0.08);
  color: var(--navy-900);
}

.toast {
  position: fixed;
  right: 18px;
  bottom: 90px;
  background: rgba(11, 23, 42, 0.92);
  color: white;
  padding: 12px 16px;
  border-radius: 12px;
  box-shadow: 0 18px 30px rgba(0,0,0,0.18);
  font-weight: 700;
}

@media (max-width: 720px) {
  .brand-copy h1 {
    font-size: 4.2rem;
  }

  .auth-card {
    padding: 18px 16px;
  }

  .quick-actions,
  .two-col,
  .banks-grid,
  .segmented-toggle {
    grid-template-columns: 1fr;
  }

  .dashboard-header,
  .section-head,
  .admin-request,
  .right-side {
    flex-direction: column;
    align-items: flex-start;
  }

  .main-content {
    padding-left: 14px;
    padding-right: 14px;
  }
}
